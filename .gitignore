# Compiled binaries (root release copies; pattern excludes platform suffixes)
/dasiwa-true-video-enhancer
dasiwa-true-video-enhancer-linux-*
dasiwa-true-video-enhancer-windows-*
!dasiwa-true-video-enhancer-linux-amd64
!dasiwa-true-video-enhancer-windows-amd64.exe
!dasiwa-true-video-enhancer-windows-arm64.exe
bin/dasiwa-true-video-enhancer

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Venv
runtime/venv/

# Hermes session plans and local agent state
.hermes/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Uploads
uploads/

# Screenshots / test captures
*.png
*.jpg
*.jpeg
!assets/*.webp
take_screenshot.py
*_screenshot*.py

# Temporary / scratch files
*.tmp
*.bak
*.orig
*.swp
*.swo
~$*
*.lock

# Jupyter notebooks (scratch work)
.ipynb_checkpoints/
*.ipynb

# Trained models (large downloads, do not commit)
models/*.safetensors
models/*.onnx
models/.trt-cache/
models/.tensorrt-engine-cache/

# Local repository index/cache
.projectatlas/
